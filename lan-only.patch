diff --git a/crates/oink-network/src/lan.rs b/crates/oink-network/src/lan.rs
new file mode 100644
--- /dev/null
+++ b/crates/oink-network/src/lan.rs
@@ -0,0 +1,12 @@
+//! LAN-only build: reject any peer address that is not on a private/loopback/link-local network.
+
+use std::net::SocketAddr;
+
+/// Returns true only for addresses that are guaranteed to stay inside the local
+/// network: loopback, RFC 1918 private ranges, and link-local addresses.
+pub(crate) fn is_lan(addr: SocketAddr) -> bool {
+    match addr.ip() {
+        std::net::IpAddr::V4(ip) => ip.is_private() || ip.is_loopback() || ip.is_link_local(),
+        std::net::IpAddr::V6(ip) => ip.is_loopback() || ip.is_unicast_link_local(),
+    }
+}

